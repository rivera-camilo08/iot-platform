# Postgres
POSTGRES_DB=iot_platform
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=change_me

# App
DATABASE_URL=postgresql+psycopg2://iot_user:change_me@db:5432/iot_platform
# Generate a secure 32-byte hex key for JWT_SECRET_KEY:
#   openssl rand -hex 32
JWT_SECRET_KEY=change_me_generate_with_openssl

# MQTT
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=iot-platform-listener
MQTT_USERNAME=iot_listener
MQTT_PASSWORD=tu_clave_segura
 
# CORS
# JSON array format for pydantic parsing
CORS_ORIGINS=["https://tu-frontend.com","http://localhost:3000"]
