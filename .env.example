# PostgreSQL configuration for local development.
# Use POSTGRES_HOST=db when running inside Docker Compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=iot_platform
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=change_me

# DATABASE_URL can be provided directly or computed from the POSTGRES_* values.
# DATABASE_URL=postgresql+psycopg2://iot_user:change_me@localhost:5432/iot_platform

# App
JWT_SECRET_KEY=change_me_generate_with_openssl
ENVIRONMENT=development

# MQTT
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=iot-platform-listener
MQTT_USERNAME=iot_listener
MQTT_PASSWORD=tu_clave_segura

# CORS
# JSON array format for pydantic parsing
CORS_ORIGINS=["https://tu-frontend.com","http://localhost:3000"]
